{
  "name": "wordjourney",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:standalone": "npm run build && node scripts/export-wordgame.mjs",
    "build:sonarannak": "npm run build:standalone",
    "build:pages": "npm run build -- --base /wordjourney/ --outDir dist-pages",
    "preview": "vite preview --host 0.0.0.0",
    "preview:pages": "node scripts/serve-pages.mjs",
    "test": "node --test --test-isolation=none tests/*.test.js",
    "test:e2e": "playwright test",
    "test:sonarannak": "npm run test:e2e",
    "android:setup": "bash scripts/setup-android.sh",
    "android:build": "bash scripts/build-android.sh",
    "publish:playtest": "node scripts/publish-playtest.mjs --publish"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@playwright/test": "1.64.1",
    "vite": "6.4.5"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0"
  }
}
